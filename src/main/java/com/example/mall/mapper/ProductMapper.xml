<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mall.mapper.ProductMapper">

    <select id="selectTopProducts" resultType="com.example.mall.vo.ChartItem">
        SELECT name,sales value  from product
        WHERE
            `status` =1
          and deleted = 0
        ORDER BY  sales desc
            LIMIT 5
    </select>
</mapper>